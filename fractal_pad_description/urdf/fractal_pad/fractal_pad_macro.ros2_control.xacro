<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="fractal_pad_ros2_control" params="
               name
               prefix
               use_mock_hardware:=false
               mock_sensor_commands:=false
               sim_gazebo_classic:=false
               sim_gazebo:=false
               simulation_controllers"
               >

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>fractal_pad_hardware/FractalPadHW</plugin>
          <param name="device">$(arg serial_device)</param>
          <param name="baud_rate">115200</param>
          <!-- ESP32 Commander entry registered with command.add('M', ...). -->
          <param name="command_prefix">M</param>
        </xacro:unless>
      </hardware>
      <joint name="${prefix}motor_joint">
        <!-- SimpleFOC uses radians for angle target, position, and velocity. -->
        <command_interface name="position">
          <param name="min">-6.283185307</param>
          <param name="max">6.283185307</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
        <!-- Read-only values from <target,velocity,shaft_angle,current_q,voltage_q>. -->
        <state_interface name="target_position"/>
        <state_interface name="current_q"/>
        <state_interface name="voltage_q"/>
      </joint>
    </ros2_control>

    <xacro:if value="$(arg sim_gazebo_classic)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>${simulation_controllers}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg sim_gazebo)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${simulation_controllers}</parameters>
          <controller_manager_node_name>${prefix}controller_manager</controller_manager_node_name>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
