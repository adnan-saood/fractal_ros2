<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find fractal_pad_description)/urdf/common/inertials.xacro" />
  <xacro:include filename="$(find fractal_pad_description)/urdf/common/materials.xacro" />

  <xacro:macro name="fractal_pad" params="prefix parent planning_mode:=false *origin">
    <!-- Approximate geometry only; replace with measured CAD when available. -->
    <link name="${prefix}fractal_coupler">
      <xacro:default_inertial />
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_coupler.stl" />
        </geometry>
        <material name="grey" />
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_coupler.stl" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}fractal_L1">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_L1.stl" />
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_L1.stl" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}motor_body">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_GM2804.stl" />
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_GM2804.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fractal_L2">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_L2.stl" />
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_L2.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fractal_L4">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_L4.stl" />
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_L4.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fractal_L3">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_L3.stl" />
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_L3.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fractal_L5325">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_L5325-Omega.stl" />
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_L5325-Omega.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fractal_fingertip_holder">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_fingertip_holder.stl" />
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_fingertip_holder.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}fractal_S1813">
      <xacro:default_inertial/>
      <visual>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/visual/fractal_S1813-Elite.stl" />
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://fractal_pad_description/meshes/fractal_pad/collision/fractal_S1813-Elite.stl" />
        </geometry>
      </collision>
    </link>


    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}fractal_coupler"/>
    </joint>
    <!-- this here is the moving joint named orignially motor_joint -->
    <joint name="${prefix}L1_joint" type="fixed">
      <origin xyz="-0.0354 0 -0.032" rpy="0 0 ${pi/2}"/>
      <parent link="${prefix}fractal_coupler"/>
      <child link="${prefix}fractal_L1"/>
    </joint>
    <joint name="${prefix}L1_motor_body_joint" type="fixed">
      <origin xyz="0 -0.025 0" rpy="0 0 ${pi/2}"/>
      <parent link="${prefix}fractal_L1"/>
      <child link="${prefix}motor_body"/>
    </joint>
    <xacro:if value="${planning_mode == True or planning_mode == 'true'}">
      <!-- Fixed neutral geometry for the seven-joint Panda MoveIt group. -->
      <joint name="${prefix}L1_L2_joint" type="fixed">
        <parent link="${prefix}motor_body"/>
        <child link="${prefix}fractal_L2"/>
        <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
      </joint>
      <joint name="${prefix}L2_L4_joint" type="fixed">
        <parent link="${prefix}fractal_L2"/>
        <child link="${prefix}fractal_L4"/>
        <origin xyz="0.0095 0 0.009" rpy="0 0 -2.257926628929"/>
      </joint>
      <joint name="${prefix}L1_L3_joint" type="fixed">
        <parent link="${prefix}fractal_L1"/>
        <child link="${prefix}fractal_L3"/>
        <origin xyz="0 -0.043 -0.022" rpy="${pi/2} -2.355131484931 0"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${planning_mode == True or planning_mode == 'true'}">
      <joint name="${prefix}L1_L2_joint" type="continuous">
        <parent link="${prefix}motor_body"/>
        <child link="${prefix}fractal_L2"/>
        <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${pi/2}" upper="${2*pi}" effort="1" velocity="1"/>
      </joint>
      <joint name="${prefix}L2_L4_joint" type="revolute">
        <parent link="${prefix}fractal_L2"/>
        <child link="${prefix}fractal_L4"/>
        <origin xyz="0.0095 0 0.009" rpy="0 0 -2.257926628929"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="${2*pi}" effort="1" velocity="1"/>
      </joint>
      <joint name="${prefix}L1_L3_joint" type="continuous">
        <parent link="${prefix}fractal_L1"/>
        <child link="${prefix}fractal_L3"/>
        <origin xyz="0 -0.043 -0.022" rpy="${pi/2} -2.355131484931 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="${2*pi}" effort="1" velocity="1"/>
      </joint>
    </xacro:unless>
    

    <joint name="${prefix}L1_L5325_joint" type="fixed">
      <origin xyz="0.0051 -0.0637 -0.0362" rpy="0 ${pi} 0"/>
      <parent link="${prefix}fractal_L1"/>
      <child link="${prefix}fractal_L5325"/>
    </joint>

    <joint name="${prefix}L4_fingertip_holder_joint" type="fixed">
      <origin xyz="0.0026 -0.0315 0.002" rpy="1 ${pi/2} 0 "/>
      <parent link="${prefix}fractal_L4"/>
      <child link="${prefix}fractal_fingertip_holder"/>
    </joint>

    <joint name="${prefix}fingertip_holder_S1813_joint" type="fixed">
      <origin xyz="0.0 0.009 0.0105" rpy="-0.22 0 ${pi}"/>
      <parent link="${prefix}fractal_fingertip_holder"/>
      <child link="${prefix}fractal_S1813"/>
    </joint>

  </xacro:macro>
</robot>
