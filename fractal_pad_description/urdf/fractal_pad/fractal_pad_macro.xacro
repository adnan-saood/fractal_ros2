<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find fractal_pad_description)/urdf/common/inertials.xacro" />
  <xacro:include filename="$(find fractal_pad_description)/urdf/common/materials.xacro" />

  <xacro:macro name="fractal_pad" params="prefix parent *origin">
    <!-- Approximate geometry only; replace with measured CAD when available. -->
    <link name="${prefix}base_link">
      <xacro:default_inertial/>
      <visual>
        <geometry><cylinder length="0.04" radius="0.05"/></geometry>
        <material name="black"/>
      </visual>
      <collision><geometry><cylinder length="0.04" radius="0.05"/></geometry></collision>
    </link>
    <link name="${prefix}motor_link">
      <xacro:default_inertial/>
      <visual>
        <origin xyz="0 0 0.04"/>
        <geometry><cylinder length="0.08" radius="0.035"/></geometry>
        <material name="blue"/>
      </visual>
      <collision><origin xyz="0 0 0.04"/><geometry><cylinder length="0.08" radius="0.035"/></geometry></collision>
    </link>
    <link name="${prefix}pad_link">
      <xacro:default_inertial/>
      <visual>
        <origin xyz="0.065 0 0.08"/>
        <geometry><box size="0.10 0.10 0.02"/></geometry>
        <material name="red"/>
      </visual>
      <collision><origin xyz="0.065 0 0.08"/><geometry><box size="0.10 0.10 0.02"/></geometry></collision>
    </link>
    <link name="${prefix}tool0"/>

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>
    <joint name="${prefix}motor_joint" type="continuous">
      <origin xyz="0 0 0.02"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}motor_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="0" velocity="50"/>
    </joint>
    <joint name="${prefix}motor-pad_joint" type="fixed">
      <parent link="${prefix}motor_link"/>
      <child link="${prefix}pad_link"/>
    </joint>
    <joint name="${prefix}pad-tool0_joint" type="fixed">
      <origin xyz="0.115 0 0.08"/>
      <parent link="${prefix}motor_link"/>
      <child link="${prefix}tool0"/>
    </joint>
  </xacro:macro>
</robot>
